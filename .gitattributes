# Normalise line endings so a Windows checkout does not show every file as modified.
# Text files are stored LF in the repository; Git converts on checkout as needed.
* text=auto eol=lf

# Binary formats — never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.db    binary
*.sqlite binary

# Notebooks are JSON text but diff poorly; keep them LF and unmerged by hand.
*.ipynb text eol=lf
