# ============================================================
# NutriMind AI configuration — copy to `.env` and fill in.
# NEVER commit the real .env file (it is git-ignored).
# Setup walkthrough: docs/IBM_SETUP.md
# ============================================================

# ---- IBM watsonx.ai (IBM Cloud Lite) ----
WATSONX_APIKEY=your-ibm-cloud-iam-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
# Must match the region you chose at signup — see region table in docs/IBM_SETUP.md §6
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Optional: only needed for deployment spaces (not used for project inference)
# WATSONX_SPACE_ID=

# Model IDs verified against the live IBM catalog on 2026-07-06.
# granite-4-h-small is the current multitenant (token-billed, Lite-compatible)
# Granite chat model. Run `python scripts/check_watsonx.py` to list what your
# region offers before changing these.
WATSONX_MODEL_ID=ibm/granite-4-h-small
WATSONX_EMBEDDING_MODEL_ID=ibm/granite-embedding-278m-multilingual

# ---- Application ----
# live = require IBM, fail fast | demo = never call IBM | auto = live if credentials work, else demo
APP_MODE=auto
# watsonx = IBM embeddings | local = sentence-transformers | auto = watsonx, else local, else hash
EMBEDDINGS_PROVIDER=auto
# Leave unset and a random key is generated once into instance/secret_key.
# Set it explicitly in production so the key is managed with your other secrets:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-generate-a-random-value
# Off by default. Set to 1 ONLY on your own machine — the debug console allows
# arbitrary code execution, so it must never be enabled on a reachable host.
FLASK_DEBUG=0
MAX_UPLOAD_MB=15
LOG_LEVEL=INFO
# How long a signed-in session lasts before re-authentication is required.
SESSION_DAYS=14
# Number of reverse proxies in front of the app. 0 unless you run behind
# nginx/Caddy/a load balancer — see docs/DEPLOYMENT.md. Getting this wrong
# either lets clients spoof their IP or rate-limits every user as one.
TRUSTED_PROXY_HOPS=0

# ---- Deployment (docker compose) -------------------------------------------
# The hostname Caddy obtains a TLS certificate for. Use `localhost` to bring the
# stack up without a public DNS name — Caddy issues a local certificate instead.
NUTRIMIND_DOMAIN=localhost
# Address for certificate-expiry warnings. Optional but recommended.
NUTRIMIND_TLS_EMAIL=

# ---- Document indexing (runs in the background, off the request thread) ----
# Threads available for indexing uploads. Small on purpose: extraction and
# lexical embedding are pure Python and hold the GIL, so more ingest threads
# compete with the threads serving pages rather than adding throughput. Raise it
# when embeddings go to watsonx, where the work is network I/O.
INGEST_WORKERS=2
# Documents that may be queued before further uploads are refused. A refused
# upload is stored and marked 'failed' with a retry message rather than dropped.
INGEST_QUEUE_LIMIT=32

# ---- RAG retrieval tuning (defaults documented in nutrimind/config.py) ----
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
# Leave unset: each embedding provider supplies the threshold calibrated for
# its own vector space (semantic ~0.35, lexical ~0.12). Setting one value here
# overrides all of them and will silently break whichever it does not suit.
# RAG_SIMILARITY_THRESHOLD=
