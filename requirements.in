# NutriMind AI — direct runtime dependencies, as intent.
#
# This file records WHICH packages the application needs and the minimum
# versions it relies on. It is the file a human edits.
#
# requirements.txt holds the exact versions that are actually installed and
# tested. Regenerate it after changing anything here:
#
#     pip install pip-tools
#     pip-compile requirements.in --output-file requirements.txt
#
# Run pip-compile on the same Python version as CI and production (3.13).

# Web framework
flask>=3.0
flask-sqlalchemy>=3.1
flask-wtf>=1.2
python-dotenv>=1.0

# Session-cookie authentication.
flask-login>=0.6

# Production WSGI server.
#
# A runtime dependency, not a deploy-time `pip install`. Everything else the
# application runs on is pinned here and scanned by pip-audit in CI; the one
# component directly exposed to the internet must not be the exception, chosen
# by whatever the registry happened to serve on deployment day.
#
# Waitress rather than gunicorn for one reason: it is the same server on Windows
# and Linux, so what is tested locally is what runs in the container. gunicorn
# would mean the development machine and production never run the same code.
#
# >=3.0.1: 3.0.0 and earlier are affected by request-smuggling advisories
# (CVE-2024-49768 / CVE-2024-49769).
waitress>=3.0.1

# Database schema migrations (Alembic, wired to the app factory).
# Runtime, not dev-only: production applies migrations as a deployment step.
flask-migrate>=4.1

# PostgreSQL driver. Kept in the default runtime set rather than an optional
# extra so the Postgres code path is always installed and testable; SQLite
# remains the development default and nothing imports this unless
# DATABASE_URI points at Postgres.
psycopg[binary]>=3.2

# IBM watsonx.ai
#
# This is the dependency that decides which Python versions the project can run
# on. Every release declares an upper bound and it moves:
#     1.2.x   >=3.10,<3.13
#     1.3.x   >=3.10,<3.14
#     1.4-1.5 >=3.11,<3.14
#     1.5.13+ >=3.11,<3.15
# The floor is >=1.6 so the resolver cannot pick a release that silently
# narrows the supported interpreter range. Re-check this bound before changing
# the Python version in CI or the deployment image.
ibm-watsonx-ai>=1.6

# RAG
chromadb>=0.5
pypdf>=4.0

# PDF export
reportlab>=4.0

# Optional local embedding fallback (heavy: pulls PyTorch). Install only if you
# want offline embeddings: pip install sentence-transformers
# sentence-transformers>=3.0
